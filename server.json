{
  "schemaVersion": 1,
  "id": "satori",
  "name": "Satori MCP",
  "packageName": "@zokizuan/satori-mcp",
  "version": "7.4.2",
  "description": "Local-first code intelligence for AI coding agents: natural-language + lexical repository search, exact source/symbol navigation, relationships, freshness, and indexing.",
  "install": {
    "command": "npx",
    "args": [
      "-y",
      "@zokizuan/satori-cli@latest",
      "install",
      "--client",
      "all"
    ],
    "managedRuntime": true
  },
  "clients": {
    "codex": {
      "configPath": "~/.codex/config.toml",
      "configFormat": "toml"
    },
    "claude": {
      "configPath": "~/.claude.json",
      "configFormat": "json"
    },
    "opencode": {
      "configPath": "~/.config/opencode/opencode.json",
      "configFormat": "jsonc"
    }
  }
}
