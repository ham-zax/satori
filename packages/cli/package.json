{
  "name": "@satori-code/cli",
  "version": "0.7.4",
  "description": "Install, configure, diagnose, and upgrade Satori's local-first MCP runtime for Claude Code, Codex, and OpenCode.",
  "keywords": [
    "satori",
    "mcp",
    "model-context-protocol",
    "code-intelligence",
    "coding-agents",
    "claude-code",
    "codex",
    "opencode",
    "installer"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "satori": "dist/index.js"
  },
  "scripts": {
    "build": "pnpm clean && node ../../node_modules/typescript7/bin/tsc --build && pnpm fix:bin-perms && node -e \"const fs=require('fs');fs.copyFileSync('src/managed-launcher-script.mjs','dist/managed-launcher-script.mjs');fs.copyFileSync('../core/dist/runtime-contract.js','dist/runtime-identities.cjs');fs.copyFileSync('../core/dist/runtime-contract.d.ts','dist/runtime-identities.d.cts')\"",
    "dev": "tsx --watch src/index.ts",
    "clean": "rimraf dist tsconfig.tsbuildinfo .tsbuildinfo",
    "lint": "oxlint --config ../../.oxlintrc.json src",
    "lint:fix": "oxlint --config ../../.oxlintrc.json src --fix",
    "typecheck": "node ../../node_modules/typescript7/bin/tsc --build",
    "start": "tsx src/index.ts",
    "release:smoke": "tsx scripts/release-smoke.ts",
    "fix:bin-perms": "node -e \"const fs=require('fs');try{fs.chmodSync('dist/index.js',0o755);}catch(e){console.error(e);process.exit(1);}\"",
    "prepublishOnly": "pnpm build",
    "test": "pnpm --filter @satori-code/mcp build:runtime && pnpm run build && pnpm run test:raw",
    "test:raw": "node --import tsx --test --test-reporter=../../scripts/satori-test-reporter.mjs --test-concurrency=8 \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "jsonc-parser": "^3.3.1",
    "toml-eslint-parser": "^1.0.3"
  },
  "satoriManagedRuntime": {
    "mcp": "0.10.4",
    "core": "0.10.1",
    "lanceDb": "0.40.0",
    "oxcParser": "0.155.0",
    "lateOn": {
      "transformers": "4.3.1",
      "onnxruntimeNode": "1.30.0",
      "sharpNativePackages": {
        "linux-x64-gnu": [
          "@img/sharp-linux-x64@0.35.5",
          "@img/sharp-libvips-linux-x64@1.3.4"
        ],
        "linux-x64-musl": [
          "@img/sharp-linuxmusl-x64@0.35.5",
          "@img/sharp-libvips-linuxmusl-x64@1.3.4"
        ]
      }
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@satori-code/core": "workspace:*",
    "@satori-code/mcp": "workspace:*",
    "tsx": "^4.23.15",
    "typescript": "7.1.0-beta"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/runtime-identities.cjs",
    "dist/runtime-identities.d.cts",
    "README.md",
    "assets/skills/**/SKILL.md",
    "!dist/**/*.test.*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ham-zax/satori.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ham-zax/satori",
  "bugs": {
    "url": "https://github.com/ham-zax/satori/issues"
  },
  "author": "Hamza (@ham-zax)",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
