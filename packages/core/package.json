{
  "name": "@satori-code/core",
  "version": "0.10.1",
  "description": "Indexing, language analysis, Publications, and hybrid retrieval for Satori's local-first code intelligence.",
  "keywords": [
    "code-intelligence",
    "code-search",
    "semantic-search",
    "hybrid-search",
    "repository",
    "typescript"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./semantic": {
      "types": "./dist/semantic/index.d.ts",
      "require": "./dist/semantic/index.js",
      "default": "./dist/semantic/index.js"
    },
    "./integration": {
      "types": "./dist/integration.d.ts",
      "require": "./dist/integration.js",
      "default": "./dist/integration.js"
    },
    "./lancedb": {
      "types": "./dist/lancedb.d.ts",
      "require": "./dist/lancedb.js",
      "default": "./dist/lancedb.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm clean && node ../../node_modules/typescript7/bin/tsc --build",
    "dev": "node ../../node_modules/typescript7/bin/tsc --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo .tsbuildinfo",
    "lint": "oxlint --config ../../.oxlintrc.json src",
    "lint:fix": "oxlint --config ../../.oxlintrc.json src --fix",
    "typecheck": "node ../../node_modules/typescript7/bin/tsc --build",
    "test": "pnpm run test:raw",
    "test:raw": "node --liftoff-only --import tsx --import ./src/test-state-root.ts --test --test-reporter=../../scripts/satori-test-reporter.mjs --test-concurrency=8 \"src/**/!(index-equivalence-sync-*|index-equivalence-toggles|typescript-semantic-publication).test.ts\" && pnpm run test:raw:heavy",
    "test:raw:heavy": "node --liftoff-only --import tsx --import ./src/test-state-root.ts --test --test-reporter=../../scripts/satori-test-reporter.mjs --test-concurrency=1 \"src/generation/{index-equivalence-sync-*,index-equivalence-toggles,typescript-semantic-publication}.test.ts\"",
    "test:integration": "pnpm run build && HOME=/tmp node --test --test-concurrency=1 ../../tests/integration/*.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@lancedb/lancedb": "0.40.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "@zilliz/milvus2-sdk-node": "^3.0.6",
    "apache-arrow": "21.2.0",
    "ignore": "^7.0.14",
    "openai": "^7.43.0",
    "oxc-parser": "0.155.0",
    "voyageai": "^0.4.0",
    "web-tree-sitter": "0.27.1",
    "ws": "^8.22.0",
    "typescript": "7.1.0-beta"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "assets/tree-sitter/**",
    "assets/cbm-extractor/*.js",
    "assets/cbm-extractor/*.wasm",
    "assets/cbm-extractor/manifest.json",
    "assets/semantic-engine/**",
    "assets/native-projections/linux-x64/projection.node",
    "assets/native-projections/linux-x64/manifest.json",
    "assets/native-projections/linux-x64/THIRD_PARTY_NOTICES.md",
    "README.md",
    "!dist/**/*.test.*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ham-zax/satori.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ham-zax/satori",
  "bugs": {
    "url": "https://github.com/ham-zax/satori/issues"
  },
  "author": "Hamza (@ham-zax)",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
