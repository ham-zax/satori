  "cards": [
    {
      "dot": "cyan",
      "title": "Search",
      "items": [
        "Dense + BM25 hits merged by RRF",
        "LateOn rescores a bounded top set",
        "Results grouped under owning symbols"
      ]
    },
    {
      "dot": "amber",
      "title": "Index version",
      "items": [
        "One complete snapshot: vectors, symbols, call edges, file outlines",
        "Each request stays pinned to one version",
        "A new version goes live only when complete"
      ]
    },
    {
      "dot": "emerald",
      "title": "Background indexing",
      "items": [
        "Scan hashes only changed files",
        "Runs in supervised workers, off the request path",
        "One shared runtime serves all local agents"
      ]
    },
    {
      "dot": "violet",
      "title": "Language coverage",
      "items": [
        "~160 languages admitted for search by extension, filename, or shebang",
        "Tree-sitter + CBM semantic engines give calls for core languages",
        "CBM extractors add symbols for 89 more (39 in npm, 101 from Hugging Face)",
        "Missing module → file degrades to search-only, reported in status"
      ]
    }
