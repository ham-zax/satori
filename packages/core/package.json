{
  "name": "@zokizuan/satori-core",
  "version": "3.8.0",
  "description": "Core indexing and retrieval engine for Satori's codebase map.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./semantic": {
      "types": "./dist/semantic/index.d.ts",
      "require": "./dist/semantic/index.js",
      "default": "./dist/semantic/index.js"
    },
    "./lancedb": {
      "types": "./dist/lancedb.d.ts",
      "require": "./dist/lancedb.js",
      "default": "./dist/lancedb.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm clean && tsc --build",
    "dev": "tsc --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo .tsbuildinfo",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --build",
    "test": "pnpm run test:raw",
    "test:raw": "node --import tsx --import ./src/test-state-root.ts --test --test-reporter=../../scripts/satori-test-reporter.mjs --test-concurrency=8 src/**/*.test.ts",
    "test:integration": "pnpm run build && HOME=/tmp node --test --test-concurrency=1 ../../tests/integration/*.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@lancedb/lancedb": "0.31.0",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "@zilliz/milvus2-sdk-node": "^2.6.17",
    "apache-arrow": "18.1.0",
    "ignore": "^7.0.5",
    "ollama": "^0.5.16",
    "openai": "^5.23.2",
    "oxc-parser": "0.139.0",
    "voyageai": "^0.3.1",
    "web-tree-sitter": "0.26.10",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "assets/tree-sitter/**",
    "assets/semantic-engine/**",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ham-zax/satori.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ham-zax/satori",
  "bugs": {
    "url": "https://github.com/ham-zax/satori/issues"
  },
  "author": "Hamza (@ham-zax)",
  "license": "AGPL-3.0-only",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
