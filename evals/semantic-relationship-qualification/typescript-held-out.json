  "cases": [
    {
      "id": "typescript.structural_decoy",
      "construct": "structural static-type decoy",
      "scenario": "A variable is statically typed as StructuralA but immutably initialized with StructuralB; the runtime callable is StructuralB.request.",
      "oracle": { "mode": "exact", "claim": "runtime_callable" },
      "expected": {
        "decision": "resolved", "relationshipType": "CALLS",
        "targetRefs": ["target.primary"], "candidateRefs": [],
        "forbiddenTargetRefs": ["target.decoy"],
        "authorities": ["origin_flow"], "strategies": ["type_dispatch"],
        "requiredEvidenceKinds": ["call_site", "assignment_origin", "target_provenance"]
      }
    },
    {
      "id": "typescript.mutable_reassignment",
      "construct": "mutable structural reassignment",
      "scenario": "A mutable structural receiver is assigned two compatible implementations before a call; neither target is authoritative.",
      "oracle": { "mode": "exact", "claim": "candidate_evidence" },
      "expected": {
        "decision": "ambiguous", "relationshipType": "REFERENCES",
        "targetRefs": [], "candidateRefs": ["target.a", "target.b"], "forbiddenTargetRefs": [],
        "authorities": ["ambiguous"], "strategies": ["type_dispatch"],
        "requiredEvidenceKinds": ["call_site", "branch_origin", "candidate_set", "ambiguity"]
      }
    },
    {
      "id": "typescript.nested_write",
      "construct": "nested block structural write",
      "scenario": "A structural receiver is written inside a nested block; bounded evidence must retain both viable implementations.",
      "oracle": { "mode": "exact", "claim": "candidate_evidence" },
      "expected": {
        "decision": "ambiguous", "relationshipType": "REFERENCES",
        "targetRefs": [], "candidateRefs": ["target.a", "target.b"], "forbiddenTargetRefs": [],
        "authorities": ["ambiguous"], "strategies": ["type_dispatch"],
        "requiredEvidenceKinds": ["call_site", "branch_origin", "candidate_set", "ambiguity"]
      }
    },
    {
      "id": "typescript.loop_write",
      "construct": "loop structural write",
      "scenario": "A structural receiver may be rewritten inside a loop; the resolver must not invent a single authoritative origin.",
      "oracle": { "mode": "exact", "claim": "candidate_evidence" },
