{
  "name": "satori",
  "version": "0.9.1",
  "description": "A codebase map for AI coding agents before they edit.",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build:cli": "pnpm --filter @satori-code/cli build",
    "build:core": "pnpm --filter @satori-code/core build",
    "build:mcp": "pnpm --filter @satori-code/mcp build",
    "dev": "pnpm -r dev",
    "dev:cli": "pnpm --filter @satori-code/cli dev",
    "dev:core": "pnpm --filter @satori-code/core dev",
    "dev:mcp": "pnpm --filter @satori-code/mcp dev",
    "dev:install-local-mcp": "node scripts/install-local-mcp-runtime.mjs",
    "dev:install-local-mcp:no-build": "node scripts/install-local-mcp-runtime.mjs --no-build",
    "clean": "pnpm -r clean",
    "test": "pnpm --filter @satori-code/core test && pnpm --filter @satori-code/mcp test && pnpm --filter @satori-code/cli test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run versions:check && pnpm run scope:check",
    "check:fast": "pnpm run lint && pnpm run versions:check && pnpm run scope:check",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r run lint:fix",
    "typecheck": "node scripts/typecheck-all.mjs",
    "versions:check": "node scripts/check-version-freshness.mjs",
    "scope:check": "node scripts/check-package-scope.mjs",
    "semantic:build": "node scripts/build-semantic-engine.mjs",
    "semantic:verify": "node scripts/verify-semantic-engine-reproducibility.mjs",
    "cbm-extractor:sync": "node scripts/cbm-extractor-sync.mjs",
    "cbm-extractor:build": "node scripts/build-cbm-extractors.mjs",
    "cbm-extractor:verify": "node scripts/verify-cbm-extractors.mjs",
    "parity:languages": "node --import tsx scripts/language-parity.mts",
    "release:check": "node scripts/qualify-release-candidate.mjs",
    "release:check:packed": "node scripts/check-release-graph.mjs",
    "release:bump": "node scripts/bump-release-graph.mjs",
    "test:scripts": "node --import tsx --test --test-reporter=./scripts/satori-test-reporter.mjs scripts/*.test.mjs evals/agent-discovery/*.test.mjs evals/real-repo-quality/*.test.mjs evals/score.test.mjs",
    "test:cbm-calls-product": "pnpm run build && pnpm --filter @satori-code/mcp exec tsx ../../scripts/cbm-multilang-call-graph-product-run.ts",
    "release": "node scripts/release.mjs",
    "release:all": "node scripts/publish-release-graph.mjs",
    "release:login": "npm login --auth-type=web",
    "release:verify": "node scripts/release-registry.mjs",
    "release:smoke:cli": "pnpm -C packages/cli release:smoke",
    "release:smoke:mcp": "pnpm -C packages/mcp release:smoke",
    "release:core": "node scripts/publish-release-graph.mjs core",
    "release:mcp": "node scripts/publish-release-graph.mjs mcp",
    "release:cli": "node scripts/publish-release-graph.mjs cli",
    "test:integration": "pnpm --filter @satori-code/core run test:integration",
    "eval:useful-context:record": "node scripts/satori-useful-context-record.mjs",
    "eval:vector-stacks": "node scripts/satori-vector-stack-compare.mjs",
    "eval:useful-context:fixtures": "node scripts/satori-useful-context-fixture-record.mjs",
    "eval:search-quality": "pnpm --filter @satori-code/mcp exec tsx ../../evals/search-quality/run.ts",
    "eval:agent-discovery": "node --no-warnings evals/agent-discovery/run-opencode.mjs",
    "eval:agent-discovery:baseline": "node --no-warnings evals/agent-discovery/run-opencode.mjs --acceptance-baseline",
    "benchmark": "node scripts/build-benchmark.js",
    "vs:code-intelligence": "node scripts/code-intelligence-vs.mjs",
    "findings:check": "node scripts/check-piolium-findings.mjs --head HEAD --root piolium/findings"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "assert": "^2.1.0",
    "ajv": "^8.20.0",
    "browserify-zlib": "^0.2.0",
    "eslint": "^10.11.0",
    "https-browserify": "^1.0.0",
    "os-browserify": "^0.3.0",
    "rimraf": "^6.1.3",
    "stream-http": "^3.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript7": "npm:typescript@7.0.2",
    "url": "^0.11.4",
    "vm-browserify": "^1.1.2"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "pnpm": {
    "overrides": {
      "flatted": "^3.4.2",
      "jws": "^4.0.1",
      "path-to-regexp": "^8.4.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ham-zax/satori.git"
  },
  "homepage": "https://github.com/ham-zax/satori",
  "bugs": {
    "url": "https://github.com/ham-zax/satori/issues"
  },
  "license": "AGPL-3.0-only",
  "author": "Hamza (@ham-zax)"
}
